# Pencill Configuration Template
# Copy this file to .env.local and replace with your actual production keys.
# Never commit .env or .env.local with real secrets to version control.

# Supabase (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# Required for AI Quiz Generation, Pedagogical Assessment, Distractor Analysis & Course Synthesis
GEMINI_API_KEY=your_gemini_api_key_here
